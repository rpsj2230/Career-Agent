# ---- Required ----------------------------------------------------------------
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=            # Supabase > Project Settings > API > service_role (keep secret, server only)
SUPABASE_ANON_KEY=                    # Supabase > Project Settings > API > "anon" / publishable key (safe to expose; used for sign-in)
ALLOWED_EMAILS=you@example.com        # comma-separated emails allowed to use the app; anyone else is refused (fail-closed)
INVITE_CODE=                          # 16+ random characters; needed once to create your account on the login page
CRON_SECRET=                          # long random string; lets GitHub Actions / Vercel Cron call /api/cron/*  (openssl rand -base64 32)

# ---- At least ONE model key (all have free tiers; limits change, check each provider) --
GEMINI_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
GITHUB_MODELS_TOKEN=
ANTHROPIC_API_KEY=                    # optional, paid API credits (a Claude subscription does NOT work here)

# ---- Job sources (all optional; Remotive, Greenhouse and Lever need no key) ------------
ADZUNA_APP_ID=                        # free key from developer.adzuna.com (covers India)
ADZUNA_APP_KEY=
RAPIDAPI_KEY=                         # JSearch on RapidAPI (free plan available)

# ---- One-click apply worker ---------------------------------------------------------
GITHUB_REPO=rpsj2230/Career-Agent     # owner/repo that holds .github/workflows/apply.yml
GITHUB_DISPATCH_TOKEN=                # fine-grained PAT: this repo only, "Actions: read and write"
GITHUB_REF_NAME=main

# ---- Notifications (optional) -------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
APP_URL=https://YOUR-APP.vercel.app
