# ---- Required ----------------------------------------------------------------
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=            # Supabase > Project Settings > API > service_role (keep secret, server only)
CRON_SECRET=                          # 16+ random characters (openssl rand -base64 32). Lets GitHub Actions / Vercel Cron call /api/cron/*,
                                      # and is also the invite code you type once on the login page to create your account.
# Optional: a separate invite code, and extra emails (besides the owner) allowed to sign in.
# INVITE_CODE=
# ALLOWED_EMAILS=

# ---- Model keys: OPTIONAL here. The easier way is to paste each key on the app's Models page (stored encrypted). --
GEMINI_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
GITHUB_MODELS_TOKEN=
ANTHROPIC_API_KEY=                    # optional, paid API credits (a Claude subscription does NOT work here)

# ---- Job sources (all optional; Remotive, Greenhouse and Lever need no key) ------------
ADZUNA_APP_ID=                        # free key from developer.adzuna.com (covers India)
ADZUNA_APP_KEY=
RAPIDAPI_KEY=                         # JSearch on RapidAPI (free plan available)

# ---- One-click apply worker ---------------------------------------------------------
GITHUB_REPO=rpsj2230/Career-Agent     # owner/repo that holds .github/workflows/apply.yml
GITHUB_DISPATCH_TOKEN=                # fine-grained PAT: this repo only, "Actions: read and write"
GITHUB_REF_NAME=main

# ---- Notifications (optional) -------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
APP_URL=https://YOUR-APP.vercel.app
